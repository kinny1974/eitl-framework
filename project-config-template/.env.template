# ============================================================
# EitL Framework v1.1.0 — Project environment template
# ============================================================
# Copy this file to .env (or export the variables) and adjust the
# values for your environment BEFORE initializing a project.
#
# NOTE: the init scripts read variables from the environment
# (export them or `source` this file); they do not auto-load .env.

# --- Project -------------------------------------------------
PROJECT_NAME=my-first-eitl-project

# --- LLM endpoints (OpenAI-compatible) ------------------------
CPU_BASEURL=http://localhost:11434/v1
GPU_BASEURL=http://localhost:11434/v1
API_KEY=not-needed

# --- Memory ---------------------------------------------------
# Standalone mode (no memory server):
MEMORY_ENABLED=false

# --- KinnyCode Memory Plugin (Native TypeScript) -------------
# Recommended: Use the native TypeScript plugin instead of MCP wrapper
# The plugin connects directly to the KinnyCode server without Python dependencies
#
# Installation:
#   cd F:\kinnyCodeMemory\plugin-kinnycode
#   npm install
#   npm run build
#
# Configuration:
# KINNYCODE_SERVER_URL=http://192.168.2.111:8007    # KinnyCode server URL
# KINNYCODE_PROJECT_ID=6b6a8b869aea48ad            # Project ID in KinnyCode
#
# Or set in opencode.jsonc directly:
#   "plugin": [
#     ["opencode-kinnycode-memory", {
#       "serverUrl": "http://192.168.2.111:8007",
#       "projectId": "6b6a8b869aea48ad"
#     }]
#   ]

# --- KinnyCode MCP Wrapper (Legacy Python) -------------------
# DEPRECATED: Consider migrating to the native TypeScript plugin
# KINYCODE_PATH=/opt/kinnycode/memory                     # Linux/macOS (ruta SIEMPRE local)
# MEMORY_URL=http://127.0.0.1:8006                        # local (puerto real de KinnyCode v2.x)
# MEMORY_URL=http://192.168.1.50:8007                     # O remoto: IP:puerto de otro equipo
# (los scripts la leen como MEMORY_URL; el MCP generado la recibe como MEMORY_SERVER_URL)
# ⚠️ Wrapper KinnyCode v2.2.0 ignora MEMORY_SERVER_URL (BASE_URL=127.0.0.1:8006 hardcodeada)
#    → parche de 1 línea o port-forward local (ver doc/06 §6.2 L11)

# --- Memory Plugin block --------------------------------------
# The init scripts now honor MEMORY_ENABLED (T-17/M5 resuelto):
#   MEMORY_ENABLED=false (or unset)  → plugin disabled
#   MEMORY_ENABLED=true              → plugin enabled
# No manual edit of .opencode/opencode.jsonc is needed anymore.
#
# Plugin priority (auto-detected):
#   1. opencode-kinnycode-memory (Native TypeScript) - Recommended
#   2. MCP wrapper (Legacy Python) - Consider migrating
#   3. Standalone (file-based) - No memory server required
