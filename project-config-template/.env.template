# ============================================================
# EitL Framework v1.0b — Project environment template
# ============================================================
# Copy this file to .env (or export the variables) and adjust the
# values for your environment BEFORE initializing a project.
#
# NOTE: the init scripts read variables from the environment
# (export them or `source` this file); they do not auto-load .env.

# --- Project -------------------------------------------------
PROJECT_NAME=my-first-eitl-project

# --- LLM endpoints (OpenAI-compatible) ------------------------
CPU_BASEURL=http://localhost:11434/v1
GPU_BASEURL=http://localhost:11434/v1
API_KEY=not-needed

# --- Memory ---------------------------------------------------
# Standalone mode (no memory server):
MEMORY_ENABLED=false

# KinnyCode (memory server) — uncomment and set when MEMORY_ENABLED=true:
# KINYCODE_PATH=/opt/kinnycode/memory                     # Linux/macOS
# MEMORY_URL=http://127.0.0.1:8005
# MEMORY_SERVER_URL=http://127.0.0.1:8005
# MEMORY_PYTHON_PATH=                                     # e.g. <KinnyCodePath>/.venv/bin/python
# MEMORY_WRAPPER_PATH=                                    # e.g. <KinnyCodePath>/mcp_wrapper.py

# --- Memory MCP block -----------------------------------------
# The init scripts now honor MEMORY_ENABLED (T-17/M5 resuelto):
#   MEMORY_ENABLED=false (or unset)  → mcp.kinnycode-memory "enabled": false
#   MEMORY_ENABLED=true              → mcp.kinnycode-memory "enabled": true
# No manual edit of .opencode/opencode.jsonc is needed anymore.
