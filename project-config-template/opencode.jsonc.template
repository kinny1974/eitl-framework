{
  "$schema": "https://opencode.ai/schema.json",
  "plugin": [
    [
      "opencode-kinnycode-memory",
      {
        "serverUrl": "{{KINNYCODE_SERVER_URL}}",
        "projectId": "{{KINNYCODE_PROJECT_ID}}"
      }
    ],
    "context-guard",
    "opencode-queue"
  ],
  "provider": {
    "llama-cpp-cpu": {
      "name": "Hell-House (CPU Stack)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{{CPU_BASEURL}}",
        "apiKey": "{{API_KEY}}"
      },
      "models": {
        "gemma-4-26b-openvino": {
          "name": "gemma-4-26b-openvino",
          "contextWindow": 131072,
          "maxTokens": 4096,
          "default": true
        }
      }
    },
    "llama-cpp-gpu": {
      "name": "Hell-House (GPU Stack)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{{GPU_BASEURL}}",
        "apiKey": "{{API_KEY}}"
      },
      "models": {
        "qwen3.6-35b-64k": {
          "name": "qwen3.6-35b-64k",
          "contextWindow": 65536,
          "maxTokens": 4096,
          "default": false
        },
        "qwen3.6-35b-128k": {
          "name": "qwen3.6-35b-128k",
          "contextWindow": 131072,
          "maxTokens": 4096,
          "default": true
        },
        "gpt-oss-20b-128k": {
          "name": "gpt-oss-20b-128k",
          "contextWindow": 131072,
          "maxTokens": 4096,
          "default": false
        }
      }
    },
    "toon-translator": {
      "name": "TOON Translator (Small Model)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{{TOON_BASEURL}}",
        "apiKey": "{{TOON_API_KEY}}"
      },
      "models": {
        "qwen2.5-3b-instruct": {
          "name": "qwen2.5-3b-instruct",
          "contextWindow": 8192,
          "maxTokens": 2048,
          "default": true
        }
      }
    }
  },
  "agent": {
    "scrum-master": {
      "description": "Technical Scrum Master of the Engineering in the Loop (EitL) pipeline. Manages project state, coordinates agents via @mentions, and generates the CURRENT PROJECT STATE block in every interaction. The only agent that interacts directly with the user.",
      "mode": "primary",
      "prompt": "{file:agents/scrum-master.md}",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "ask",
        "task": {
          "product-owner": "allow",
          "architect": "allow",
          "tdd-engineer": "allow",
          "validator": "allow",
          "test-runner": "allow",
          "qa-engineer": "allow",
          "performance-engineer": "allow",
          "toon-translator": "allow"
        },
        "skill": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "todowrite": "allow",
        "todoread": "allow"
      },
      "color": "#4CAF50"
    },
    "toon-translator": {
      "description": "TOON Translator Agent. Orquesta la conversión NL a TOON mediante el orquestador Python (scripts/toon/orchestrator.py).",
      "mode": "subagent",
      "prompt": "{file:agents/toon-translator.md}",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "ask",
        "task": "deny",
        "skill": "allow",
        "websearch": "deny",
        "webfetch": "allow",
        "todowrite": "allow",
        "todoread": "allow"
      },
      "color": "#00BCD4"
    }
  }
}
