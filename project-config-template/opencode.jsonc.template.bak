{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "kinnycode-memory": {
      "type": "local",
      "command": [
        "{{KINYCODE_PYTHON_PATH}}",
        "{{KINYCODE_WRAPPER_PATH}}"
      ],
      "description": "KinnyCode Multi-Layer Memory - RAG semantico, persistencia de conversaciones, indexacion de documentos, tareas agentivas.",
      "environment": {
        "MEMORY_SERVER_URL": "{{MEMORY_SERVER_URL}}",
        "KINNYCODE_PROJECT_ID": "{{KINNYCODE_PROJECT_ID}}"
      },
      "enabled": {{MEMORY_ENABLED}}
    }
  },
  "provider": {
    "llama-cpp-cpu": {
      "name": "Hell-House (CPU Stack)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{{CPU_BASEURL}}",
        "apiKey": "{{API_KEY}}"
      },
      "models": {
        "gemma-4-26b-openvino": {
          "name": "gemma-4-26b-openvino",
          "contextWindow": 131072,
          "maxTokens": 4096,
          "default": true
        }
      }
    },
    "llama-cpp-gpu": {
      "name": "Hell-House (GPU Stack)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{{GPU_BASEURL}}",
        "apiKey": "{{API_KEY}}"
      },
      "models": {
        "qwen3.6-35b-64k": {
          "name": "qwen3.6-35b-64k",
          "contextWindow": 65536,
          "maxTokens": 4096,
          "default": false
        },
        "qwen3.6-35b-128k": {
          "name": "qwen3.6-35b-128k",
          "contextWindow": 131072,
          "maxTokens": 4096,
          "default": true
        },
        "gpt-oss-20b-128k": {
          "name": "gpt-oss-20b-128k",
          "contextWindow": 131072,
          "maxTokens": 4096,
          "default": false
        }
      }
    }
  },
  "plugin": [
    "opencode-working-memory",
    "context-guard",
    "@tarquinen/opencode-dcp",
    "opencode-snip",
    "envsitter-guard",
    "@slkiser/opencode-quota"
  ],
  "agent": {
    "scrum-master": {
      "description": "Technical Scrum Master of the Engineering in the Loop (EitL) pipeline. Manages project state, coordinates agents via @mentions, and generates the CURRENT PROJECT STATE block in every interaction. The only agent that interacts directly with the user.",
      "mode": "primary",
      "prompt": "{file:agents/scrum-master.md}",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "ask",
        "task": {
          "product-owner": "allow",
          "architect": "allow",
          "tdd-engineer": "allow",
          "validator": "allow",
          "test-runner": "allow",
          "qa-engineer": "allow",
          "performance-engineer": "allow"
        },
        "skill": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "todowrite": "allow",
        "todoread": "allow"
      },
      "color": "#4CAF50"
    },
    "product-owner": {
      "description": "Product Owner experto que traduce requerimientos del cliente en Product Backlog, Sprints propuestos y Criterios de Aceptacion verificables. Genera el artefacto 01_Plan_Scrum.md.",
      "mode": "subagent",
      "prompt": "{file:agents/product-owner.md}",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "deny",
        "task": "deny",
        "skill": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "todowrite": "allow",
        "todoread": "allow"
      },
      "color": "#2196F3"
    },
    "architect": {
      "description": "Arquitecto de Software Senior que disena arquitecturas antes de cualquier linea de codigo (Forward Engineering estricto). Genera el Software Design Document 02_Architecture_SDD.md.",
      "mode": "subagent",
      "prompt": "{file:agents/architect.md}",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "deny",
        "task": "deny",
        "skill": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "todowrite": "allow",
        "todoread": "allow"
      },
      "color": "#9C27B0"
    },
    "tdd-engineer": {
      "description": "Ingeniero de Software especialista en TDD (Test-Driven Development). Define pruebas EJECUTABLES antes de que exista codigo. Mantra: Red -> Green -> Refactor. Genera el artefacto 03_Plan_TDD.md.",
      "mode": "subagent",
      "prompt": "{file:agents/tdd-engineer.md}",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "deny",
        "task": "deny",
        "skill": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "todowrite": "allow",
        "todoread": "allow"
      },
      "color": "#FF9800"
    },
    "validator": {
      "description": "Guardian de Calidad del pipeline EitL. Su palabra es ley: REJECTED = pipeline DETENIDO. Valida artefactos contra metodologias strictas con checklists especificas por tipo.",
      "mode": "subagent",
      "prompt": "{file:agents/validator.md}",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "deny",
        "task": "deny",
        "skill": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "todowrite": "allow",
        "todoread": "allow"
      },
      "color": "#F44336"
    },
    "test-runner": {
      "description": "Ejecutor de tests automatizado del pipeline EitL. Corre suites de pruebas, recolecta resultados, genera reportes de cobertura y bloquea el pipeline si hay regressions. FAIL = pipeline DETENIDO.",
      "mode": "subagent",
      "prompt": "{file:agents/test-runner.md}",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "task": "deny",
        "skill": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "todowrite": "allow",
        "todoread": "allow"
      },
      "color": "#00BCD4"
    },
    "qa-engineer": {
      "description": "Ingeniero de Calidad de Codigo del pipeline EitL. Ejecuta linting, type checking, analisis estatico de seguridad (SAST) y genera reportes de calidad. CRITICAL ISSUES = pipeline DETENIDO.",
      "mode": "subagent",
      "prompt": "{file:agents/qa-engineer.md}",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "task": "deny",
        "skill": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "todowrite": "allow",
        "todoread": "allow"
      },
      "color": "#795548"
    },
    "performance-engineer": {
      "description": "Ingeniero de Rendimiento del pipeline EitL. Ejecuta benchmarks, load testing y profiling para validar Non-Functional Requirements (NFRs). NFR BREACH = pipeline DETENIDO.",
      "mode": "subagent",
      "prompt": "{file:agents/performance-engineer.md}",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "task": "deny",
        "skill": "allow",
        "websearch": "allow",
        "webfetch": "allow",
        "todowrite": "allow",
        "todoread": "allow"
      },
      "color": "#E91E63"
    }
  }
}